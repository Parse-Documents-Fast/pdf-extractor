# ============================================================
# pdf-extractor — variables de entorno
# Copiar a .env y ajustar.
# ============================================================

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Redis Streams (contrato con pdf-main) ---
REDIS_STREAM_INPUT=queue:extraction
REDIS_STREAM_OUTPUT=queue:extraction-results
REDIS_STREAM_DLQ=queue:extraction-dlq
REDIS_CONSUMER_GROUP=pdf-extractor-group
CONSUMER_NAME=pdf-extractor-1

# --- HTTP ---
HTTP_ADDR=:8000

# --- Procesamiento y Concurrencia ---
WORKER_COUNT=1
REDIS_MAX_RETRIES=5
REDIS_RETRY_BACKOFF_MS=1000
PDF_MAX_BYTES=20971520
PDF_EXTRACTION_TIMEOUT=30s

# --- Umbrales de Markdown ---
FONT_SIZE_HEADING_THRESHOLD=1.5
FONT_SIZE_SUBHEADING_THRESHOLD=1.2

# --- Logging ---
LOG_LEVEL=info

# --- Shutdown ---
HTTP_SHUTDOWN_TIMEOUT=15s
