# ============================================================
# pdf-extractor — variables de entorno
# Copiar a .env y ajustar. Los valores marcados [CONFIRMAR]
# deben reconciliarse con los demás repos (pdf-main, etc.).
# ============================================================

# --- Redis ---
# [CONFIRMAR] host/puerto en la red interna
REDIS_URI=redis://localhost:6379/0
# Timeout de conexion (dial/read/write) al cliente Redis
REDIS_CONNECT_TIMEOUT=5s

# --- Redis Streams (contrato con pdf-main) ---
STREAM_EXTRACTION=queue:extraction
STREAM_RESULTS=queue:extraction-results
# [CONFIRMAR] la DLQ la propone este servicio
STREAM_DLQ=queue:extraction-dlq
CONSUMER_GROUP=pdf-extractor-group
# Nombre único por instancia (ej: hostname del contenedor)
CONSUMER_NAME=pdf-extractor-1

# --- MongoDB ---
# [CONFIRMAR] host/puerto/credenciales en la red interna
MONGO_URI=mongodb://localhost:27017
# Timeout de conexion y seleccion de servidor del cliente MongoDB
MONGO_CONNECT_TIMEOUT=10s
# [CONFIRMAR] nombre de base y colección
MONGO_DB=pdf_extractor
MONGO_COLLECTION=pdf_documents

# --- HTTP (solo /health y /metrics) ---
HTTP_ADDR=:8080

# --- Procesamiento ---
WORKER_CONCURRENCY=2
MAX_RETRIES=3
# Tamaño máximo de PDF aceptado, en bytes (default 20 MiB)
PDF_MAX_BYTES=20971520
# Timeout de extracción por documento
EXTRACTION_TIMEOUT=30s

# --- Umbrales de Markdown (relativos al tamaño de fuente predominante) ---
HEADING_RATIO_H1=1.8
HEADING_RATIO_H2=1.4
HEADING_RATIO_H3=1.15

# --- Logging ---
LOG_LEVEL=info

# --- Shutdown ---
# Tiempo maximo para cerrar conexiones (Redis, MongoDB) al apagar
SHUTDOWN_TIMEOUT=10s
